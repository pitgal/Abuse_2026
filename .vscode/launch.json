{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/abuse.app/Contents/MacOS/abuse",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "linux": {
                "MIMode": "gdb"
            },
            "osx": {
                "MIMode": "lldb",
                "targetArchitecture": "arm"
            },
            "windows": {
                "MIMode": "gdb"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build debug"
        },
        {
            "name": "Run release",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/abuse.app/Contents/MacOS/abuse",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build release"
        }
    ]
}
