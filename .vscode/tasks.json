{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build/debug",
                "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/debug/src",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/debug"],
            "dependsOn": "Configure debug",
            "dependsOrder": "sequence",
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always"},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Prepare debug",
            "type": "shell",
            "command": "test -f build/debug/.installed || (cmake --install build/debug && touch build/debug/.installed)",
            "dependsOn": "Build debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Configure release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build/release",
                "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/release/src",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build release",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/release"],
            "dependsOn": "Configure release",
            "dependsOrder": "sequence",
            "group": {"kind": "build", "isDefault": false},
            "presentation": {"reveal": "always"},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Prepare release",
            "type": "shell",
            "command": "test -f build/release/.installed || (cmake --install build/release && touch build/release/.installed)",
            "dependsOn": "Build release",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}