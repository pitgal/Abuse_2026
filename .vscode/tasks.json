{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build/debug",
                "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/debug/src",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build/debug"
            ],
            "dependsOn": "Configure debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build/release",
                "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/release/src",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build/release"
            ],
            "dependsOn": "Configure release",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}